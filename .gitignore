# Git Ignore Rules
# Dependencies
node_modules/
.venv/
env/
venv/

# Build and Distribution Outputs
dist/
build/
*.egg-info/
.eggs/

# Upstream Mirror (Cloned locally during pipeline build, not committed to repo)
.upstream/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Environment & Logs
.env
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
